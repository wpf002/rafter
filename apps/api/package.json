{
  "name": "@rafter/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsup src/index.ts --format cjs --clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@rafter/db": "workspace:*",
    "@rafter/engine": "workspace:*",
    "@rafter/ingest": "workspace:*",
    "@rafter/measurement": "workspace:*",
    "@rafter/types": "workspace:*",
    "exifr": "^7.1.3",
    "fastify": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.0"
  }
}
